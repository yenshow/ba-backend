# --- 伺服器 ---
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://192.168.2.8:3000,http://192.168.2.8:3001,https://ba-frontend-construction.vercel.app,https://ba-frontend-central.vercel.app

# --- JWT（正式環境務必改為強隨機字串）---
JWT_SECRET=14t0gj50igj30fj4093hgi03j4g03
JWT_EXPIRES_IN=7d

# --- 授權 ---
# 部署樣貌：central（智慧管理平台）或 construction（工地）；決定可啟用的 feature keys
LICENSE_DEPLOYMENT_PROFILE=central
LICENSE_OPEN_ALL_FEATURES=true
LICENSE_PLATFORM_API_BASE_URL=https://api.yenshow.com/api/license
LICENSE_SIGN_SECRET=5b5229d70021962d76dfbf1ffd170fa14f34048330d7f8c38428b971f3081efa

# --- 主資料庫（PostgreSQL）---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ba_system
DB_USER=postgres
DB_PASSWORD=postgres

# --- 功能開關 ---
ENABLE_YSCP_DATABASE=false

# --- MediaMTX（串流；與 mediamtx.yml 的 apiAddress / webrtcAddress 埠一致）---
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889