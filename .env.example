# --- 伺服器 ---
HOST=0.0.0.0
PORT=4000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost

# --- JWT（正式環境務必改為強隨機字串）---
JWT_SECRET=gfqkjgqikjgqgjqpweg
JWT_EXPIRES_IN=7d

# --- 授權 ---
# 可選：LICENSE_DEPLOYMENT_PROFILE（預設 central）
LICENSE_PLATFORM_API_BASE_URL=https://api.yenshow.com/api/license
LICENSE_SIGN_SECRET=5b5229d70021962d76dfbf1ffd170fa14f34048330d7f8c38428b971f3081efa

# --- 主資料庫（PostgreSQL）---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ba_system
DB_USER=postgres
DB_PASSWORD=postgres

# --- 功能開關（布林；未設定時為 false）---
# ENABLE_YSCP_DATABASE：false 時關閉 YSCP 外部資料庫（不連 CMS DB、不查人流／車輛外部表、不推 yscp:event:*）
ENABLE_YSCP_DATABASE=false

# --- YSCP／外部平台（安裝精靈「環境設定」；變更後須重啟 PM2）---
YSCP_HOST=127.0.0.1
YSCP_DB_PASSWORD=
YSCP_AK=
YSCP_SK=

# --- MediaMTX（串流；埠需與 mediamtx.yml 的 apiAddress / webrtcAddress 一致）---
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889
