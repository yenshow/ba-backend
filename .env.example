# --- 伺服器 ---
HOST=0.0.0.0
PORT=4000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost:80

# --- JWT（正式環境務必改為強隨機字串）---
JWT_SECRET=gfqkjgqikjgqgjqpweg
JWT_EXPIRES_IN=7d

# --- 授權 ---
# 可選：LICENSE_DEPLOYMENT_PROFILE（預設 central）、LICENSE_OPEN_ALL_FEATURES（僅開發）；詳 AGENTS.md。
LICENSE_PLATFORM_API_BASE_URL=https://api.yenshow.com/api/license
LICENSE_SIGN_SECRET=5b5229d70021962d76dfbf1ffd170fa14f34048330d7f8c38428b971f3081efa

# --- 主資料庫（PostgreSQL）---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ba_system
DB_USER=postgres
DB_PASSWORD=postgres

# --- YSCP（外部 CMS）---
# YSCP_HOST：IP 或 hostname（勿含 https://）；PostgreSQL 埠 5432／使用者 postgres／庫名 cms；API 版本 v1 固定
YSCP_HOST=
YSCP_DB_PASSWORD=
YSCP_AK=
YSCP_SK=

# --- 功能開關（布林；未設定時為 true）---
# ENABLE_YSCP_PEOPLE_COUNTING：false 時關閉 YSCP 人流（不連外部 CMS DB、不推 yscp:event:acs）；
ENABLE_YSCP_PEOPLE_COUNTING=false

# --- MediaMTX（串流；埠需與 mediamtx.yml 的 apiAddress / webrtcAddress 一致）---
# 後端 Control API 固定連本機；瀏覽器 WHEP 主機由前端依目前網址自動帶入
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889

# --- 警報日界線（每日批次 active→resolved、連動 DO 復歸；忽視僅當曆日阻擋）---
ALERT_DAILY_ROLLOVER_TZ=Asia/Taipei
ALERT_DAILY_ROLLOVER_LOCAL_HOUR=0
ALERT_DAILY_ROLLOVER_LOCAL_MINUTE=5

# --- 備份排程（建議用新鍵；舊鍵仍相容）---
# 線上 DB 熱資料保留天數：逾此門檻之列會匯出 CSV 並在驗證通過後刪除
BACKUP_DATABASE_CUTOFF_DAYS=30
# BACKUP_RETENTION_DAYS=30
# backups/ 目錄內 CSV 保留天數（依檔案 mtime 刪除過期檔）
BACKUP_ARCHIVE_FILE_RETENTION_DAYS=365
# BACKUP_FILE_RETENTION_DAYS=365
# 排程間隔（毫秒）；伺服器啟動後會立即執行一次
BACKUP_SCHEDULER_INTERVAL=86400000
