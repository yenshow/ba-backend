# 後端環境變數範本
# 使用方式：複製為 ba-backend/.env 並依現場修改；勿將含祕鑰的 .env 提交版控。
# 鍵名與語意 SSOT：docs/10-setting/env-deploy-matrix.md
# 載入路徑：預設讀取工作目錄下 .env；可用 ENV_FILE 指向其他檔案。

# --- 可選：自訂 env 檔路徑 ---
# ENV_FILE=C:\path\to\ba-backend.env

# --- 伺服器 ---
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# 逗號分隔；須含實際前端 origin（含埠），例：http://192.168.2.8:3000,http://192.168.2.8:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- 主資料庫（PostgreSQL）---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=ba_system
DB_CONNECTION_LIMIT=10

# --- JWT（正式環境務必改為強隨機字串）---
JWT_SECRET=CHANGE_ME_STRONG_RANDOM
JWT_EXPIRES_IN=7d

# --- Modbus（全域逾時 ms）---
MODBUS_TIMEOUT=2000

# --- 背景監控 ---
MONITORING_ENABLED=true

# --- 警報日界線（每日批次 active→resolved、連動 DO 復歸；忽視僅當曆日阻擋）---
ALERT_DAILY_ROLLOVER_ENABLED=true
ALERT_DAILY_ROLLOVER_TZ=Asia/Taipei
ALERT_DAILY_ROLLOVER_LOCAL_HOUR=0
ALERT_DAILY_ROLLOVER_LOCAL_MINUTE=5

# --- 功能開關 ---
ENABLE_YSCP_PEOPLE_COUNTING=true
ENABLE_ACCESS_CONTROL_PERSONNEL=true

# --- 外部資料庫（整合來源）---
EXTERNAL_DB_HOST=192.168.2.2
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_USER=postgres
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_NAME=cms
EXTERNAL_DB_CONNECTION_LIMIT=5

# --- 授權 ---
LICENSE_OPEN_ALL_FEATURES=false
LICENSE_PLATFORM_API_BASE_URL=
LICENSE_PLATFORM_TIMEOUT_MS=8000
LICENSE_SIGN_SECRET=

# --- YSCP ---
YSCP_HOST=https://192.168.2.2
YSCP_AK=
YSCP_SK=
YSCP_API_VER=v1
YSCP_REJECT_UNAUTHORIZED=false

# --- MediaMTX（串流）---
MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_BASE_URL=http://127.0.0.1:8889
MEDIAMTX_TIMEOUT_MS=10000

# --- 日誌 ---
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
ENABLE_REQUEST_LOGS=false
ENABLE_DETAILED_LOGS=false
LOG_WS_CONNECTIONS=false
LOG_WS_PUSH=false

# --- 備份排程 ---
BACKUP_RETENTION_DAYS=30
BACKUP_FILE_RETENTION_DAYS=365
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL=86400000
BACKUP_COMPRESSION_ENABLED=false

# --- 僅供 npm run external-data:* 腳本（非 runtime 必填）---
# API_USER=
# API_PASSWORD=
